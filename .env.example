# Copy to .env and fill in. .env is gitignored.
NEURONPEDIA_API_KEY=            # https://www.neuronpedia.org/account (graph generation, steering API)
RUNPOD_API_KEY=                 # optional: only for the paper-scale jobs (budget-capped at $20)
HF_TOKEN=                       # optional: gated models (Gemma, Llama) and uploading trained models

# Caches (put them on a drive with space)
HF_HOME=D:\AI\circuits-atlas\hf-cache
TORCH_HOME=D:\AI\circuits-atlas\torch-cache
UV_CACHE_DIR=D:\AI\circuits-atlas\uv-cache
UV_LINK_MODE=copy
# Path of the token written by `hf auth login` (needed when HF_HOME is moved; gated models such as FLUX.1-schnell).
HF_TOKEN_PATH=~/.cache/huggingface/token
